diff --git a/src/render_helpers/shaders/refract_and_clip.frag b/src/render_helpers/shaders/refract_and_clip.frag
new file mode 100644
index 00000000..09bdad47
--- /dev/null
+++ b/src/render_helpers/shaders/refract_and_clip.frag
@@ -0,0 +1,94 @@
+#version 100
+
+//_DEFINES_
+
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+
+uniform float alpha;
+varying vec2 v_coords;
+
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+
+uniform float niri_scale;
+
+uniform vec2 geo_size;
+uniform vec4 corner_radius;
+uniform mat3 input_to_geo;
+
+// Refraction at the edges, like a pane of glass with a rounded edge: x = width of the edge, y = depth
+// of the glass, both in logical pixels (0 = none). The edge profile is a superellipse (1 - u^3)^(1/3):
+// it starts almost flat and curves at the end, so the bend fades in without a visible line. The view
+// goes straight down, refracts at the surface (Snell, n ~ 1.5, a little different per color) and
+// travels `depth` to the backdrop.
+uniform vec2 refraction;
+
+float niri_rounding_alpha(vec2 coords, vec2 size, vec4 corner_radius);
+vec4 postprocess(vec4 color);
+
+vec2 refracted(vec3 N, float eta, vec2 to_tex) {
+    vec3 T = refract(vec3(0.0, 0.0, -1.0), N, eta);
+    return T.xy / abs(T.z) * refraction.y / geo_size * to_tex;
+}
+
+void main() {
+    vec3 coords_geo = input_to_geo * vec3(v_coords, 1.0);
+
+    vec4 color;
+    if (refraction.x > 0.0 && refraction.y > 0.0) {
+        vec2 p = coords_geo.xy * geo_size;
+        float r = max(max(corner_radius.x, corner_radius.y), max(corner_radius.z, corner_radius.w));
+        // Follow corners at least as round as the edge is wide, so the bend turns smoothly.
+        float rf = max(r, refraction.x);
+        vec2 c = geo_size * 0.5;
+        vec2 q = abs(p - c) - (c - rf);
+        vec2 o = max(q, 0.0);
+        float len = length(o);
+        vec2 axis = q.x >= q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
+        vec2 n = (len > 0.0 ? o / len : axis) * sign(p - c);
+        float d = rf - (len + min(max(q.x, q.y), 0.0));
+        float u = clamp(1.0 - d / refraction.x, 0.0, 0.999);
+        float slope = min(u * u * pow(1.0 - u * u * u, -2.0 / 3.0), 4.0);
+        vec3 N = normalize(vec3(n * slope, 1.0));
+        // From geometry-normalized offsets to texture coordinates.
+        vec2 to_tex = vec2(1.0 / input_to_geo[0][0], 1.0 / input_to_geo[1][1]);
+        vec4 g = texture2D(tex, v_coords + refracted(N, 1.0 / 1.50, to_tex));
+        color = vec4(texture2D(tex, v_coords + refracted(N, 1.0 / 1.475, to_tex)).r, g.g,
+                     texture2D(tex, v_coords + refracted(N, 1.0 / 1.525, to_tex)).b, g.a);
+    } else {
+        color = texture2D(tex, v_coords);
+    }
+#if defined(NO_ALPHA)
+    color = vec4(color.rgb, 1.0);
+#endif
+
+    color = postprocess(color);
+
+    if (coords_geo.x < 0.0 || 1.0 < coords_geo.x || coords_geo.y < 0.0 || 1.0 < coords_geo.y) {
+        // Clip outside geometry.
+        color = vec4(0.0);
+    } else {
+        // Apply corner rounding inside geometry.
+        color = color * niri_rounding_alpha(coords_geo.xy * geo_size, geo_size, corner_radius);
+    }
+
+    // Apply final alpha and tint.
+    color = color * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
