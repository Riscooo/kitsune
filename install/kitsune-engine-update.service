[Unit]
Description=Kitsune: compila su motor propio si hay una versión nueva de Gecko
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/kitsune-browser/kitsune-engine.py build --if-new --notify
# Prioridad mínima de CPU y disco: compilar no debe notarse mientras se usa el PC.
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
# El escritorio va primero: la compilación nunca pasa del 65 % de la RAM ni usa
# swap. Si lo intentara, el sistema mata solo la compilación en vez de congelar el PC.
MemoryMax=65%
MemorySwapMax=0
# Y si aun así falta memoria en el PC, el núcleo mata antes la compilación que tus aplicaciones.
OOMScoreAdjust=900
TimeoutStartSec=6h
