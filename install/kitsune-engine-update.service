[Unit]
Description=Kitsune: motor propio al día y, con un Gecko nuevo, sus paquetes y un borrador de versión
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# install.sh pone aquí la carpeta del repositorio. tools/seguir_firefox.py --auto compila el
# motor de este PC si hay Gecko o receta nuevos y, con un Gecko nuevo, los paquetes de Linux,
# Windows y macOS, sus pruebas y un borrador en GitHub (nunca publica). Cada paso va en su
# propia unidad con los límites de abajo; este proceso solo los encadena.
ExecStart=/usr/bin/python3 @REPO@/tools/seguir_firefox.py --auto
# Prioridad mínima de CPU y disco: compilar no debe notarse mientras se usa el PC.
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
# El escritorio va primero: la compilación nunca pasa del 65 % de la RAM ni usa
# swap. Si lo intentara, el sistema mata solo la compilación en vez de congelar el PC.
MemoryMax=65%
MemorySwapMax=0
# Y si aun así falta memoria en el PC, el núcleo mata antes la compilación que tus aplicaciones.
OOMScoreAdjust=900
# Los tres sistemas desde cero pueden llevar más de un día con prioridad mínima.
TimeoutStartSec=infinity
