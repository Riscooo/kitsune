#!/bin/sh
# Kitsune launches a real, isolated Gecko profile. URLs and flags remain
# separate arguments: never evaluate content supplied by a desktop URL handler.
set -u

browser_root="${XDG_DATA_HOME:-${HOME}/.local/share}/kitsune-browser"
state_root="${XDG_STATE_HOME:-${HOME}/.local/state}/kitsune-browser"
profile_id=""
profile_service="kitsune-home.service"
profile_home="http://127.0.0.1:49721/"
profile_remoting="kitsune-browser"
profile_action=""
profile_privacy="estricto"
engine_tool="${browser_root}/kitsune-engine.py"
# Kitsune's own engine: built from Mozilla's signed Gecko source on this computer.
case "${1:-}" in
    --actualizar-motor) exec nice -n 19 python3 "${engine_tool}" build --if-new ;;
    --estado-motor) exec python3 "${engine_tool}" status ;;
esac
if [ "${1:-}" = "--kitsune-profile" ]; then
    [ "$#" -ge 2 ] || { printf '%s\n' 'Falta el identificador del perfil.' >&2; exit 1; }
    profile_id="$2"
    shift 2
fi
if [ "${1:-}" = "--kitsune-action" ]; then
    [ "$#" -ge 2 ] || { printf '%s\n' 'Falta la acción del perfil.' >&2; exit 1; }
    profile_action="$2"
    shift 2
    case "${profile_action}" in
        home|google|privacy|sync|sync-settings|sync-google|passwords|settings|general|search|downloads|extensions) ;;
        *) printf '%s\n' 'La acción del perfil no es válida.' >&2; exit 1 ;;
    esac
fi
profile_dir="${browser_root}/profile"
profile_manager="${browser_root}/profiles.py"
if [ -f "${profile_manager}" ]; then
    if [ -n "${profile_id}" ]; then
        profile_json="$(python3 "${profile_manager}" --browser-root "${browser_root}" --state-root "${state_root}" resolve --id "${profile_id}")" || exit 1
    else
        profile_json="$(python3 "${profile_manager}" --browser-root "${browser_root}" --state-root "${state_root}" resolve)" || exit 1
    fi
    profile_field() {
        printf '%s' "${profile_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"
    }
    profile_id="$(profile_field id)" || exit 1
    profile_dir="$(profile_field profile)" || exit 1
    profile_home="$(profile_field home)" || exit 1
    profile_service="$(profile_field service)" || exit 1
    profile_remoting="$(profile_field remoting)" || exit 1
    profile_privacy="$(printf '%s' "${profile_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("privacyMode", ""))')" || profile_privacy=""
elif [ -n "${profile_id}" ] && [ "${profile_id}" != "default" ]; then
    printf '%s\n' 'La gestión de perfiles aún no está instalada.' >&2
    exit 1
fi
chrome_dir="${profile_dir}/chrome"
start_dir="${browser_root}/start"
mkdir -p "${chrome_dir}" "${start_dir}" "${state_root}" || exit 1
chmod 700 "${profile_dir}" "${chrome_dir}" "${state_root}" 2>/dev/null || :

# Kitsune 0.5 «Tinta»: la paleta es fija (papel de InkShadow) y la escribe la
# instalación; el escritorio ya no la sobrescribe. --sync-palette-only se
# conserva como orden vacía para que ningún hook antiguo abra el navegador.
if [ "${1:-}" = "--sync-palette-only" ]; then
    exit 0
fi

# Start the user-local home service before restoring tabs that refer to it.
# No network listener beyond loopback and no changes to browser sanitization.
case "${profile_service}" in
    kitsune-home@*) home_service="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/kitsune-home@.service" ;;
    *) home_service="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/kitsune-home.service" ;;
esac
home_available=false
if [ -f "${home_service}" ] && command -v systemctl >/dev/null 2>&1; then
    if systemctl --user start "${profile_service}"; then
        home_available=true
    fi
fi
if [ -f "${profile_manager}" ] && [ "${home_available}" != true ]; then
    printf '%s\n' 'No se ha podido iniciar el inicio privado de este perfil. No se ha abierto otro perfil.' >&2
    exit 1
fi

if [ "${1:-}" = "--home" ] || [ "${profile_action}" = home ]; then
    if [ "${1:-}" = "--home" ]; then shift; fi
    # Path.as_uri correctly handles spaces, #, Unicode and other reserved
    # characters in XDG_DATA_HOME; a raw file:// concatenation does not.
    if [ "${home_available}" = true ]; then
        start_url="${profile_home}"
    else
        start_url="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().as_uri())' "${start_dir}/index.html")" || exit 1
    fi
    set -- --new-tab "${start_url}" "$@"
fi
case "${profile_action}" in
    google) set -- --new-tab 'https://accounts.google.com/ServiceLogin' "$@" ;;
    privacy) set -- --new-tab 'about:preferences#privacy' "$@" ;;
    sync) set -- --new-tab 'about:preferences#sync' "$@" ;;
    sync-settings) set -- --new-tab 'about:preferences#sync' "$@" ;;
    passwords) set -- --new-tab 'about:logins' "$@" ;;
    settings) set -- --new-tab 'about:preferences' "$@" ;;
    general) set -- --new-tab 'about:preferences#general' "$@" ;;
    search) set -- --new-tab 'about:preferences#search' "$@" ;;
    downloads) set -- --new-tab 'about:downloads' "$@" ;;
    extensions) set -- --new-tab 'about:addons' "$@" ;;
    sync-google) set -- --new-tab 'https://accounts.firefox.com/' "$@" ;;
esac

# Privacy mode of this profile, applied by the engine's kitsune.cfg at startup.
case "${profile_privacy}" in
    estricto|comodo) ;;
    *) profile_privacy="estricto" ;;
esac

export MOZ_ENABLE_WAYLAND=1
export MOZ_APP_REMOTINGNAME="${profile_remoting}"
export KITSUNE_PRIVACY_MODE="${profile_privacy}"

# Only Kitsune's own, smoke-tested engine runs. Without one, nothing older or
# foreign is launched in its place.
engine_binary="${browser_root}/engine/current/kitsune"
if [ ! -x "${engine_binary}" ]; then
    printf '%s\n' 'El motor de Kitsune aún no está compilado. Ejecuta: kitsune-browser --actualizar-motor' >&2
    exit 1
fi
# Before the own engine first upgrades a profile last used by another engine,
# keep a copy of it (only ever taken while the profile is closed).
python3 "${engine_tool}" backup-profile --profile "${profile_dir}" || {
    printf '%s\n' 'No se pudo hacer la copia de seguridad del perfil; no se ha abierto.' >&2
    exit 1
}
exec "${engine_binary}" --profile "${profile_dir}" "$@"
