# Kitsune: motor propio compilado desde el código fuente oficial de Gecko.
# Plantilla de kitsune-engine.py; @OBJDIR@ se sustituye por la carpeta de objetos de la versión.
ac_add_options --enable-application=browser
mk_add_options MOZ_OBJDIR=@OBJDIR@

# Identidad propia, compilada dentro.
ac_add_options --with-app-name=kitsune
ac_add_options --with-app-basename=Kitsune
ac_add_options --with-branding=browser/branding/kitsune

# Versión de uso diario, sin actualizador de Mozilla ni informe de fallos.
ac_add_options --enable-release
# Canal release: sin telemetría extendida ni comportamientos de compilación de desarrollo.
ac_add_options --enable-update-channel=release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-updater
ac_add_options --disable-crashreporter
# Sin símbolos de depuración: sin informe de fallos nadie los usa, y con ellos rustc pedía más de
# 8 GB para un solo crate (el 14-10-2026 el sistema se quedó sin memoria compilando Gecko 158).
ac_add_options --disable-debug-symbols

# Traducciones (castellano) preparadas por kitsune-engine.py junto al código.
ac_add_options --with-l10n-base=@L10NBASE@

# Herramientas de Mozilla descargadas en ~/.mozbuild (sin sudo) y caché de compilación.
ac_add_options --enable-bootstrap
ac_add_options --with-ccache=sccache
